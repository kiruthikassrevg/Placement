SORTING
SELECTION SORTING

public class Main {
      
    public static void main(String[] args) {
        int arr[]={5,4,3,2,1,8,4};
        int n=arr.length;
        for(int i=0;i<n;i++){
            int minindex=i;
            for(int j=i+1;j<n;j++){
                if(arr[j]<arr[minindex]){
                    minindex=j;
                }
            }
            int temp=arr[i];
            arr[i]=arr[minindex];
            arr[minindex]=temp;
        }
         for (int i = 0; i < n; i++) {
            System.out.print(arr[i] + " ");  // Printing each element with a space
        }
    }
}

OUTPUT:
1 2 3 4 4 5 8
