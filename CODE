LINEAR SEARCH

import java.util.*;
public class Main {
    static int linear(int [] arr,int target){
        for(int i=0;i<arr.length;i++){
            if(arr[i]==target){
                return i;
            }
        }
        return -1;
    }
    public static void main(String[] args) {
        int arr[]={5,4,3,2,1,8};
        int target=8;
        System.out.print(linear(arr,target));
    }
}

OUTPUT:
