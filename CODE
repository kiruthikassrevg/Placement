public class Main {
    static int binary(int [] arr,int target,int l,int r){
        while(l<=r){
            int mid=l+(r-l)/2;
            if(arr[mid]==target){
                return mid;                
            }
            else if(target<arr[mid]){
                r=mid-1;
            }
            else
            {
                l=mid+1;
            }
        }
        return -1;
    }    
    public static void main(String[] args) {
        int arr[]={5,4,3,2,1,8};
        int target=8;
        Arrays.sort(arr);
       if(binary(arr,target,0,arr.length-1)!=-1){
           System.out.print("Element present");
       }
        else
        {
            System.out.print("Not present");
        }
    }
}

