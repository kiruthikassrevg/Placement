INSERTION SORT

public class Main {
      
    public static void main(String[] args) {
        int arr[]={5,4,3,2,1,8,4};
        int n=arr.length;
        for(int i=1;i<n;i++){
        int temp=arr[i];
        int j=i-1;
        while( j>=0&&arr[j]>temp){
        arr[j+1]=arr[j];
            j--;
        }
        arr[j+1]=temp;
        }
                 System.out.println(Arrays.toString(arr));

    }
}

OUPUT:
[1,2,3,4,5,6,8]
